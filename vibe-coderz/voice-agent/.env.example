GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Aoede
# Use the same randomly generated value in the website's .env.local.
VOICE_AGENT_TOKEN=
MAX_VOICE_SESSIONS=2
MAX_SESSION_SECONDS=300
CONNECT_TIMEOUT_SECONDS=20
DISCONNECT_TIMEOUT_SECONDS=15
GEMINI_AFFECTIVE_DIALOG=false

# Cal.com conversational booking (next integration). Keep the API key server-side.
# Use CAL_EVENT_TYPE_ID, or use both CAL_USERNAME and CAL_EVENT_TYPE_SLUG.
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
CAL_USERNAME=
CAL_EVENT_TYPE_SLUG=

# Only offer/book slots that begin during these visitor-local hours.
VISITOR_BOOKING_START_HOUR=9
VISITOR_BOOKING_END_HOUR=20

# Dashboard storage. SQLite is convenient locally; use PostgreSQL on EC2.
DATABASE_URL=sqlite:///./voice_agent.db
# Example: postgresql+psycopg://voice_agent:password@127.0.0.1:5432/voice_agent
DASHBOARD_ADMIN_EMAIL=
# Use at least 12 characters. This value never reaches the browser.
DASHBOARD_ADMIN_PASSWORD=

# Production self-hosted TURN. Leave blank for localhost development.
TURN_HOST=
# Backend-only endpoint for the same TURN server (for EC2 use its private instance address).
TURN_INTERNAL_HOST=
TURN_SHARED_SECRET=

# Optional managed relay. When enabled, both browser and EC2 peers receive
# short-lived Cloudflare TURN credentials; self-hosted coturn remains fallback.
MANAGED_TURN_ENABLED=false
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
